{
  "name": "promptlab-foundation",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.23.2 <23",
    "pnpm": "11.1.3"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @promptlab/web dev",
    "dev:worker": "corepack pnpm --filter @promptlab/worker dev",
    "dev:stack": "node tools/dev-stack.mjs",
    "dev:apps": "node tools/dev-stack.mjs --apps-only",
    "typecheck": "corepack pnpm --recursive --if-present --filter '!promptlab-foundation' typecheck && tsc --noEmit -p tools/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:api:integration": "node tools/verification/api-foundation-integration.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "build": "corepack pnpm --filter @promptlab/web build",
    "db:generate": "corepack pnpm --filter @promptlab/db db:generate",
    "db:migrate": "corepack pnpm --filter @promptlab/db db:migrate",
    "db:rollback": "corepack pnpm --filter @promptlab/db db:rollback",
    "provider:codex:probe": "node --import tsx/esm tools/provider-smoke/codex-probe.mts",
    "provider:campus:smoke": "node --import ./tools/load-root-env.mjs --import tsx/esm tools/provider-smoke/campus-smoke.mts"
  },
  "dependencies": {
    "@promptlab/providers": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.10",
    "shadcn": "4.21.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
