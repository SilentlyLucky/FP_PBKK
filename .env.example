# Local services are bound to loopback by docker-compose.yml.
PROMPTLAB_DATABASE_URL=postgresql://promptlab:promptlab@127.0.0.1:55432/promptlab
PROMPTLAB_REDIS_URL=redis://127.0.0.1:56379

# Server-side only. Leave blank until the campus supplies a valid credential.
PROMPTLAB_CAMPUS_API_KEY=
# Must be an exact model ID confirmed by the campus gateway.
# qwen3:14b was an example in the request, not a verified model identity.
PROMPTLAB_CAMPUS_MODEL=
# Optimizer calls default to 90 seconds; the full Run still has a 180-second limit.
PROMPTLAB_CAMPUS_OPTIMIZER_TIMEOUT_MS=90000
# Embeddings stay disabled until an explicitly confirmed endpoint is configured.
PROMPTLAB_CAMPUS_EMBEDDING_ENDPOINT=
PROMPTLAB_CAMPUS_EMBEDDING_MODEL=embeddinggemma:latest
PROMPTLAB_CAMPUS_EMBEDDING_TIMEOUT_MS=60000
# Set a 32-character campaign ID to enable full multi-request capability checks.
# Blank still allows a one-request manual check, but blocks the full campaign.
# Reuse the same ID across restarts; the 110-call/provider cap also covers
# worker inference while this campaign ID is active.
PROMPTLAB_PROVIDER_VERIFICATION_CAMPAIGN=

# Optional local file review. Keep disabled unless you explicitly trust and
# configure the project folder. IDs must match existing project UUIDs.
# PROMPTLAB_LOCAL_WORKSPACE_ROOTS='[{"projectId":"00000000-0000-4000-8000-000000000001","rootPath":"/absolute/path/to/project"}]'
# PROMPTLAB_LOCAL_WORKSPACE_WRITE_ENABLED=1
# PROMPTLAB_LOCAL_WORKSPACE_WRITE_PROJECTS='["00000000-0000-4000-8000-000000000001"]'
#
# Optional named checks for proposed patches. These are fixed server commands,
# not commands sent by the browser. The executable must be an absolute Node or
# supported system runtime path. Bubblewrap must be installed and available.
# The same command runs against independent baseline and candidate snapshots.
# PROMPTLAB_LOCAL_WORKSPACE_EVALUATION_COMMANDS='[{"projectId":"00000000-0000-4000-8000-000000000001","commands":[{"id":"vitest-core","label":"Core Vitest checks","executable":"/absolute/path/to/node","args":["node_modules/vitest/vitest.mjs","run","packages/tools/src/workspace-evaluation-runner.test.ts","--pool=threads","--maxWorkers=1"],"timeoutMs":60000}]}]'
