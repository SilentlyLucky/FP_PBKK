# Generate a URL-safe database password with: openssl rand -hex 32
PROMPTLAB_POSTGRES_PASSWORD=replace-with-64-hex-characters

# Configure the Senopati gateway values supplied for your own account.
# Leave these empty to start the UI and finish setup later.
PROMPTLAB_CAMPUS_API_KEY=
PROMPTLAB_CAMPUS_MODEL=
PROMPTLAB_CAMPUS_OPTIMIZER_TIMEOUT_MS=90000
# Configure only the embedding endpoint confirmed for your Campus instance.
PROMPTLAB_CAMPUS_EMBEDDING_ENDPOINT=
PROMPTLAB_CAMPUS_EMBEDDING_MODEL=embeddinggemma:latest
PROMPTLAB_CAMPUS_EMBEDDING_TIMEOUT_MS=60000
# Set a 32-character campaign ID to enable full multi-request capability checks.
# Blank still allows a one-request manual check, but blocks the full campaign.
# Reuse the same ID across restarts; the 110-call/provider cap also covers
# worker inference while this campaign ID is active.
PROMPTLAB_PROVIDER_VERIFICATION_CAMPAIGN=

# The web service is bound to 127.0.0.1 on this host port.
PROMPTLAB_WEB_PORT=3000

# Optional read-only source mount. Uncomment and set a user-selected host path
# before using compose.sources.yaml.
# PROMPTLAB_COLLECTIONS_PATH=/absolute/path/to/selected/sources
# PROMPTLAB_LOCAL_WORKSPACE_ROOTS=[{"projectId":"<existing-project-uuid>","rootPath":"/collections"}]

# Optional writable workspace. Copy compose.workspace.example.yaml to
# compose.workspace.yaml, then set these values for your own host and project.
# PROMPTLAB_WORKSPACE_PATH=/absolute/path/to/a/dedicated/workspace
# PROMPTLAB_WORKSPACE_PROJECT_ID=<existing-project-uuid>
# PROMPTLAB_WORKSPACE_GROUP_ID=1000
